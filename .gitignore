# ── Secrets ────────────────────────────────────────────────────────────────
.env

# ── Python ─────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
env/
*.egg-info/
dist/
build/
.Python

# ── Project runtime data ────────────────────────────────────────────────────
# Per-binary workspaces: Ghidra IR exports, knowledge base, LLM logs and
# the reconstructed C++ project (all reproducible from the binary)
workspace/
workspace_run.log
.pytest_cache/

# Input binaries (don't commit third-party executables)
TestBinaries/

# ── Ghidra project files ────────────────────────────────────────────────────
# The .gpr and .rep are local workspace state, not source
ghidra_project/

# ── Local inference engine / weights ────────────────────────────────────────
# llama.cpp is expected as a system install, not vendored here — but keep this
# ignore so a local clone dropped in the tree never gets committed by accident
llama.cpp/

# Model weights (large, downloaded separately)
*.gguf

# ── IDE ─────────────────────────────────────────────────────────────────────
.vscode/
.idea/
*.suo
*.user

# ── OS ──────────────────────────────────────────────────────────────────────
Thumbs.db
Desktop.ini
.DS_Store
